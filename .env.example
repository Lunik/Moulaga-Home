# Copy to .env and adjust. Every value is optional.

# Where the SQLite database lives. Keep this out of git: it contains banking data.
#MOULAGA_DATA_DIR=/data

# Extra CORS origins, comma-separated. Useful only for a Vite dev server against a remote API.
#MOULAGA_CORS_ORIGINS=http://localhost:5173

#MOULAGA_LOG_LEVEL=INFO

# Enable Secure profile cookies only when Moulaga is exposed exclusively through HTTPS.
#MOULAGA_SESSION_COOKIE_SECURE=true

# When enabled in the container, every startup wipes the database and recreates the demo seed.
# Remove MOULAGA_DEMO_MODE from docker-compose.yml (or set it to false) to preserve data.
#MOULAGA_DEMO_MODE=false
